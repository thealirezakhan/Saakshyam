# AICTE Copilot - environment reference (copy to .env; never commit real secrets)

# LLM: Groq free tier (OpenAI-compatible). Get a free key at console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Demo persistence (SQLite) and tenant
DATABASE_URL=sqlite:///./data/aicte.db
DEMO_MODE=aarohan

# Upload limit (bytes)
MAX_UPLOAD_BYTES=26214400
